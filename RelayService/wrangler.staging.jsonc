{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hermes-jr-relay-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "hermes-jr-companion.cybercultured.com", "custom_domain": true }],
  "preview_urls": false,
  "vars": { "RELAY_ENABLED": "true", "REGISTRATIONS_ENABLED": "true", "APNS_ENVIRONMENT": "sandbox" },
  "secrets": { "required": ["APNS_TEAM_ID", "APNS_KEY_ID", "APNS_TOPIC", "APNS_PRIVATE_KEY", "OPERATOR_TOKEN", "SETUP_TICKET_PRIVATE_KEY"] },
  "durable_objects": {
    "bindings": [
      { "name": "INSTALLATIONS", "class_name": "InstallationRelay" },
      { "name": "ADMISSION", "class_name": "ServiceAdmission" },
      { "name": "APNS_AUTH", "class_name": "APNsProviderToken" },
      { "name": "SETUP_INTENTS", "class_name": "SetupIntent" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InstallationRelay", "APNsProviderToken"] }, { "tag": "v2-admission", "new_sqlite_classes": ["ServiceAdmission"] }, { "tag": "v3-setup", "new_sqlite_classes": ["SetupIntent"] }],
  "ratelimits": [
    { "name": "INSTALL_RATE_LIMITER", "namespace_id": "71101", "simple": { "limit": 5, "period": 60 } },
    { "name": "REQUEST_RATE_LIMITER", "namespace_id": "71102", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 50 }
}
